APP_ENV=development
PORT=8080
INTERNAL_SERVICE_TOKEN=your_internal_service_token_here
FRONTEND_URL=http://localhost:5173
FRONTEND_PROD_URL=https://logisticshq.in

AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=your_cognito_user_pool_id
COGNITO_CLIENT_ID=your_cognito_client_id
COGNITO_CLIENT_SECRET=your_cognito_client_secret

GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here

OPENAI_API_KEY=your_openai_api_key_here
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=freel_mysql
DB_URL="root:@tcp(127.0.0.1:3306)/freel_mysql?parseTime=true&loc=UTC&multiStatements=true"
MAIL_PROVIDER=smtp

MAIL_FROM=your_email@domain.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@domain.com
SMTP_PASSWORD="your_smtp_app_password"
SMTP_TLS=true
MAILBOX_ENCRYPTION_KEY=your_base64_32byte_key
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/organizations/mailboxes/connect/gmail/callback
